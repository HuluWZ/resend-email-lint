{
  "name": "resend-email-lint",
  "version": "0.1.0",
  "description": "Lint email HTML before you send it. One rule set, three interfaces: a library, a CLI for CI, and an MCP server for agents.",
  "keywords": [
    "email",
    "lint",
    "html-email",
    "mcp",
    "cli",
    "react-email",
    "resend"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuluWZ/resend-email-lint.git"
  },
  "homepage": "https://github.com/HuluWZ/resend-email-lint#readme",
  "bugs": {
    "url": "https://github.com/HuluWZ/resend-email-lint/issues"
  },
  "author": "Hulunlante Worku",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "resend-email-lint": "./dist/cli.js",
    "resend-email-lint-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "node-html-parser": "^9.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.0.0"
  },
  "sideEffects": false
}
